#!/usr/bin/env perl
use strict;
use warnings;
use utf8;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use Getopt::Long qw(GetOptions GetOptionsFromArray);
use Typo::Fossils;
use Typo::Fossils::Counter qw(count_paths count_files top_words);
use Typo::Fossils::Detector qw(detect);
use Typo::Fossils::Exporter qw(export_pairs supported_formats infer_format write_output);
use Typo::Fossils::History qw(parse_date today);
use Typo::Fossils::Keyboard qw(supported_layouts);
use Typo::Fossils::Reader qw(find_files files_since);
use Typo::Fossils::Review qw(review);
use Typo::Fossils::Stats qw(typo_total rate report commify);
use Typo::Fossils::Store;

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

my $usage = <<'USAGE';
Usage:
  typo-fossils --version
  typo-fossils freq [--top N] [--min-count N] PATH...
  typo-fossils scan [scan options] PATH...
  typo-fossils review [--store FILE] [scan options] PATH...
  typo-fossils list [--store FILE]
  typo-fossils export [--format espanso|vim|macos] [--out FILE] [--store FILE]
  typo-fossils track [--date YYYY-MM-DD] [--since YYYY-MM-DD]
                     [--store FILE] [--history FILE] PATH...
  typo-fossils stats [--history FILE] [--top N]

Scan options:
  --top N            show at most N candidates (default 50)
  --max-distance N   largest edit distance to a correction (default 2)
  --min-common N     times a correction must appear (default 5)
  --max-typo N       times a typo may appear at most (default 3)
  --min-ratio N      how many times more common the correction must be (default 5)
  --kind KIND        slip, gap, unclear, or all (default all)
  --layout NAME      qwerty, azerty, or qwertz (default qwerty)
USAGE

sub parse_scan_options {
    my ($with_store) = @_;
    my %opt = (
        top          => 50,
        max_distance => 2,
        min_common   => 5,
        max_typo     => 3,
        min_ratio    => 5,
        kind         => 'all',
        layout       => 'qwerty',
    );
    my @spec = (
        'top=i'          => \$opt{top},
        'max-distance=i' => \$opt{max_distance},
        'min-common=i'   => \$opt{min_common},
        'max-typo=i'     => \$opt{max_typo},
        'min-ratio=i'    => \$opt{min_ratio},
        'kind=s'         => \$opt{kind},
        'layout=s'       => \$opt{layout},
    );
    push @spec, 'store=s' => \$opt{store} if $with_store;

    GetOptionsFromArray(\@ARGV, @spec) or die $usage;
    die $usage unless @ARGV;

    $opt{kind}   = lc $opt{kind};
    $opt{layout} = lc $opt{layout};

    die "Unknown kind '$opt{kind}'. Choose slip, gap, unclear, or all.\n"
        unless $opt{kind} =~ /\A(?:slip|gap|unclear|all)\z/;
    die sprintf("Unknown layout '%s'. Choose one of: %s\n", $opt{layout}, join(', ', supported_layouts()))
        unless grep { $_ eq $opt{layout} } supported_layouts();

    return \%opt;
}

sub find_candidates {
    my ($opt) = @_;
    my $counts = count_paths(@ARGV);
    my @found  = detect(
        $counts,
        max_distance => $opt->{max_distance},
        min_common   => $opt->{min_common},
        max_typo     => $opt->{max_typo},
        min_ratio    => $opt->{min_ratio},
        layout       => $opt->{layout},
    );
    @found = grep { $_->{kind} eq $opt->{kind} } @found unless $opt->{kind} eq 'all';
    splice @found, $opt->{top} if $opt->{top} < @found;
    return @found;
}

my $command = (@ARGV && $ARGV[0] =~ /^(?:freq|scan|review|list|export|track|stats)\z/) ? shift @ARGV : '';

if ($command eq 'freq') {
    my ($top, $min_count) = (50, 1);
    GetOptionsFromArray(
        \@ARGV,
        'top=i'       => \$top,
        'min-count=i' => \$min_count,
    ) or die $usage;
    die $usage unless @ARGV;

    my $counts = count_paths(@ARGV);
    my @rows   = top_words($counts, limit => $top, min_count => $min_count);

    printf "%7d  %s\n", $_->[1], $_->[0] for @rows;
    exit 0;
}

if ($command eq 'scan') {
    my $opt   = parse_scan_options(0);
    my @found = find_candidates($opt);

    if (!@found) {
        print "No typo candidates found.\n";
        exit 0;
    }

    printf "%-6s  %-16s  %-16s  %5s  %7s  %s\n", 'CONF', 'TYPO', 'FIX', 'SEEN', 'COMMON', 'KIND';
    printf "%-6s  %-16s  %-16s  %5d  %7d  %s (%s)\n",
        @{$_}{qw(confidence typo correction typo_count correction_count kind reason)}
        for @found;
    exit 0;
}

if ($command eq 'review') {
    my $opt     = parse_scan_options(1);
    my @found   = find_candidates($opt);
    my $store   = Typo::Fossils::Store->new($opt->{store});
    my $summary = review(\@found, $store);

    printf "\nAccepted %d, rejected %d, skipped %d, left %d.\nDecisions are saved in %s\n",
        @{$summary}{qw(accepted rejected skipped remaining)}, $store->path;
    exit 0;
}

if ($command eq 'list') {
    my $store_path;
    GetOptionsFromArray(\@ARGV, 'store=s' => \$store_path) or die $usage;

    my %accepted = Typo::Fossils::Store->new($store_path)->accepted;
    if (!%accepted) {
        print "No accepted typos yet.\n";
        exit 0;
    }

    printf "%-20s -> %s\n", $_, $accepted{$_} for sort keys %accepted;
    exit 0;
}

if ($command eq 'export') {
    my ($format, $out, $store_path);
    GetOptionsFromArray(
        \@ARGV,
        'format=s' => \$format,
        'out=s'    => \$out,
        'store=s'  => \$store_path,
    ) or die $usage;
    die $usage if @ARGV;

    $format = defined $format ? lc $format : infer_format($out);
    die "Choose a format with --format (" . join(', ', supported_formats())
        . ") or give --out a name ending in .yml, .vim, or .plist.\n"
        unless defined $format;

    my %pairs = Typo::Fossils::Store->new($store_path)->accepted;
    if (!%pairs) {
        print STDERR "No accepted typos yet. Run typo-fossils review first.\n";
        exit 1;
    }

    my ($text, $skipped) = export_pairs($format, \%pairs);
    my $written = keys(%pairs) - @$skipped;

    printf STDERR "Skipped %d %s the %s format cannot hold: %s\n",
        scalar(@$skipped), (@$skipped == 1 ? 'entry' : 'entries'), $format, join(', ', @$skipped)
        if @$skipped;

    if (!$written) {
        print STDERR "Nothing to export.\n";
        exit 1;
    }

    if (defined $out) {
        write_output($out, $text);
        printf "Wrote %d %s to %s (%s).\n", $written, ($written == 1 ? 'typo' : 'typos'), $out, $format;
    }
    else {
        print $text;
    }
    exit 0;
}

if ($command eq 'track') {
    my ($date, $since, $store_path, $history_path);
    GetOptionsFromArray(
        \@ARGV,
        'date=s'    => \$date,
        'since=s'   => \$since,
        'store=s'   => \$store_path,
        'history=s' => \$history_path,
    ) or die $usage;
    die $usage unless @ARGV;

    $date //= today();
    die "Invalid date '$date'. Use YYYY-MM-DD.\n" unless defined parse_date($date);

    my $since_epoch;
    if (defined $since) {
        $since_epoch = parse_date($since);
        die "Invalid date '$since'. Use YYYY-MM-DD.\n" unless defined $since_epoch;
    }

    my %pairs = Typo::Fossils::Store->new($store_path)->accepted;
    if (!%pairs) {
        print STDERR "No accepted typos yet. Run typo-fossils review first.\n";
        exit 1;
    }

    my @files = find_files(@ARGV);
    @files = files_since($since_epoch, @files) if defined $since_epoch;

    my $counts = count_files(@files);
    my $words  = 0;
    $words += $_ for values %$counts;

    if (!$words) {
        print STDERR "No words found. Check the paths" . (defined $since ? ' and --since' : '') . ".\n";
        exit 1;
    }

    my %found = map { $_ => +{ fix => $pairs{$_}, count => $counts->{$_} } }
                grep { $counts->{$_} } keys %pairs;

    my $history  = Typo::Fossils::History->new($history_path);
    my $verb     = $history->has_date($date) ? 'Updated' : 'Recorded';
    my $snapshot = $history->record(date => $date, words => $words, typos => \%found);
    $history->save;

    my $total = typo_total($snapshot);
    printf "%s %s: %s words, %d %s (%.1f per 1,000 words).\n",
        $verb, $date, commify($words), $total, ($total == 1 ? 'typo' : 'typos'), rate($snapshot);
    exit 0;
}

if ($command eq 'stats') {
    my ($history_path, $top) = (undef, 10);
    GetOptionsFromArray(
        \@ARGV,
        'history=s' => \$history_path,
        'top=i'     => \$top,
    ) or die $usage;
    die $usage if @ARGV;
    die "--top must be at least 1.\n" if $top < 1;

    my @snapshots = Typo::Fossils::History->new($history_path)->snapshots;
    print report(\@snapshots, top => $top);
    exit 0;
}

my $show_version = 0;
GetOptions('version' => \$show_version) or die $usage;

if ($show_version) {
    print "typo-fossils ", Typo::Fossils->version, "\n";
    exit 0;
}

print $usage;